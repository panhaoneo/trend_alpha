!/.github/workflows/daily.yml
!/tools
/tools/*
!/tools/__init__.py
!/tools/ths_api.py
!/tools/cninfo_api.py
!/tools/formatting.py
!/tools/filters.py
!/projects
/projects/*
!/projects/trend_alpha
/projects/trend_alpha/*
!/projects/trend_alpha/config.py
!/projects/trend_alpha/fetch.py
!/projects/trend_alpha/metrics.py
!/projects/trend_alpha/enricher.py
!/projects/trend_alpha/report.py
!/projects/trend_alpha/run.py
!/data
/data/*
